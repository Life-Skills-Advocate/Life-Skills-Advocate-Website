{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/blog/:slug",
      "destination": "/post.html?slug=:slug"
    },
    {
      "source": "/resource/:idOrSlug",
      "destination": "/resource.html?id=:idOrSlug"
    },
    {
      "source": "/post.html",
      "destination": "/post.html"
    },
    {
      "source": "/resource.html",
      "destination": "/resource.html"
    },
    {
      "source": "/:path*",
      "destination": "/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    }
  ]
}