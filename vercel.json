{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [],
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog/:slug",
      "destination": "/post.html?slug=:slug",
      "permanent": true
    },
    {
      "source": "/resource/:idOrSlug",
      "destination": "/resource.html?id=:idOrSlug",
      "permanent": true
    }
  ]
}